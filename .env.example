# ---------------------------------------------------------------------------
# Configuração única do projeto. Todo serviço (banco, API, frontend) lê daqui.
# Copie para .env e ajuste o que precisar:  cp .env.example .env
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_DB=agentic_health
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Host do banco: 'localhost' para scripts rodando na sua máquina;
# dentro do docker-compose os serviços usam o nome do serviço ('postgres').
POSTGRES_HOST=localhost

# API
API_PORT=8000

# Frontend
WEB_PORT=8081

# Origens liberadas no CORS. Sem autenticação (ADR-005), restringir a origem é o
# que impede que qualquer página consuma a API pelo navegador do usuário.
CORS_ORIGENS=http://localhost:5173,http://localhost:8081
