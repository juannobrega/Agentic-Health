{
  "name": "agentic-health-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tipos": "openapi-typescript http://localhost:8000/openapi.json -o src/api/tipos.ts",
    "tipos:verificar": "openapi-typescript http://localhost:8000/openapi.json -o /tmp/tipos-atual.ts && diff -q src/api/tipos.ts /tmp/tipos-atual.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
